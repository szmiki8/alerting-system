{
  "name": "alerting-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --watch=false --coverage",
    "check": "npm run lint && npm run format:check && npm run build && npm run check:contrast && npm run e2e:typecheck && npm run test:ci",
    "check:contrast": "node scripts/check-contrast.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=line",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
