# Environment variables of the alerting core. Copy to .env (git-ignored) and fill in the values,
# or set them in your shell / container. Secrets stay empty in this file.
# Later tasks add their variables here (database, Google login, NewsAPI.org, email, Slack).

# Spring profile: local (default), demo, postgres or aws
SPRING_PROFILES_ACTIVE=local

# Admin allow-list: comma-separated email addresses (FR-24)
ALERTING_SECURITY_ADMIN_ALLOW_LIST=admin@example.org

# Keys for subscriber addresses (BE-09). Required in the demo, postgres and aws profiles (start-up fails
# without them); in local, generated throw-away keys are used with a warning.
# Secret: active key for encrypting Slack webhook URLs at rest, as <key-id>:<base64 of 32 bytes>,
# e.g. key-2026:$(openssl rand -base64 32)
ALERTING_SECURITY_ENCRYPTION_KEY=
# Secret: earlier encryption keys (same form, comma-separated), kept only to read old data after a key rotation
ALERTING_SECURITY_ENCRYPTION_OLD_KEYS=
# Secret: key for fingerprinting subscriber addresses, base64 of at least 32 bytes (openssl rand -base64 32).
# Changing it breaks the duplicate check for existing subscribers.
ALERTING_SECURITY_FINGERPRINT_KEY=

# Operator credential for the Actuator endpoints on the management port (BE-05)
ALERTING_MANAGEMENT_OPERATOR_USERNAME=operator
# Secret: required in the demo, postgres and aws profiles (start-up fails without it);
# optional in local, where without it only the health probes are reachable
ALERTING_MANAGEMENT_OPERATOR_PASSWORD=

# PostgreSQL datasource, only for the postgres profile (BE-06). The other profiles use H2 in-memory,
# so leave the URL and user name commented out there. Defaults are in application-postgres.yaml.
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alerting
#SPRING_DATASOURCE_USERNAME=alerting
# Secret: database password (postgres profile)
SPRING_DATASOURCE_PASSWORD=
