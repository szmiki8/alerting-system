# Environment variables of the alerting core. Copy to .env (git-ignored) and fill in the values,
# or set them in your shell / container. Secrets stay empty in this file.
# Later tasks add their variables here (database, Google login, NewsAPI.org, email, Slack).

# Spring profile: local (default), demo, postgres or aws
SPRING_PROFILES_ACTIVE=local

# Admin allow-list: comma-separated email addresses (FR-24)
ALERTING_SECURITY_ADMIN_ALLOW_LIST=admin@example.org

# Secret: key for encrypting Slack webhook URLs at rest (used from BE-09)
ALERTING_SECURITY_ENCRYPTION_KEY=
# Secret: key for fingerprinting subscriber addresses (used from BE-09)
ALERTING_SECURITY_FINGERPRINT_KEY=

# Operator credential for the Actuator endpoints on the management port (BE-05)
ALERTING_MANAGEMENT_OPERATOR_USERNAME=operator
# Secret: required in the demo, postgres and aws profiles (start-up fails without it);
# optional in local, where without it only the health probes are reachable
ALERTING_MANAGEMENT_OPERATOR_PASSWORD=
